# Copy to .env and fill in from the Neon dashboard -> Connect.
# .env is gitignored; never commit real credentials.

# Pooled connection (host contains "-pooler"). Used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Optional. Migrations need a non-pooled connection; prisma.config.ts derives
# one by stripping "-pooler" from DATABASE_URL, so set this only if your
# provider does not follow that rule.
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
