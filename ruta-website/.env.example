# Copy to .env and fill in from the Neon dashboard -> Connect.
# .env is gitignored; never commit real credentials.

# Pooled connection (host contains "-pooler"). Used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Optional. Migrations need a non-pooled connection; prisma.config.ts derives
# one by stripping "-pooler" from DATABASE_URL, so set this only if your
# provider does not follow that rule.
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Google sign-in. Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials
#
# In that screen add BOTH of these, exactly:
#   Authorised JavaScript origin: http://localhost:3000
#   Authorised redirect URI:      http://localhost:3000/api/auth/google/callback
#
# The redirect URI must match GOOGLE_REDIRECT_URI below character for character
# or Google answers with redirect_uri_mismatch.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
