// Prisma schema — the single source of truth for the database shape.
//
// Apply changes with:  npx prisma migrate dev --name <what-changed>
// Regenerate the client with:  npx prisma generate
//
// The connection URL lives in prisma.config.ts (Prisma 7 moved it out of this
// file), which reads DATABASE_URL / DIRECT_URL from .env.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A registered account. Sessions are still held in memory, so this table holds
/// only what the user typed at sign-up.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// Unique and lower-cased before saving — the key used to sign in.
  email String @unique

  /// Display name. Deliberately NOT unique: two people may share a username,
  /// because email is what identifies the account.
  username String

  /// scrypt digest — what a real system stores. See src/server/auth/password.ts.
  passwordHash String

  /// CLASSROOM DEMONSTRATION ONLY — the password as typed, in the clear.
  ///
  /// This exists so the instructor can see the original password beside the
  /// digest and confirm the hashing is genuine. **No production system should
  /// ever store this.** Anyone who reads the database — or this repository,
  /// since .env is committed too — can read every password.
  ///
  /// Authentication does NOT consult this column; login still verifies against
  /// `passwordHash`. Deleting the field and its uses would not change behaviour.
  ///
  /// To remove before any real deployment:
  ///   1. delete this field
  ///   2. npx prisma migrate dev --name drop_plaintext_password
  ///   3. drop `plaintextPassword` from userStore, authService and the seed
  plaintextPassword String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
