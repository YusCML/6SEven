generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email String? @unique

  username String @unique

  nickname String?

  passwordHash String?

  plaintextPassword String?

  googleId String? @unique

  avatarUrl String?

  emailVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Route {
  id          String @id @default(uuid()) @db.Uuid

  routeNumber Int @unique

  title String

  duration String

  description String

  color String

  fare String

  distance String

  category String

  path Json

  segments Segment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("routes")
}

model Segment {
  id String @id @default(uuid()) @db.Uuid

  mode String

  from String

  to String

  duration String

  distance String?

  order Int

  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId String @db.Uuid

  @@map("route_segments")
}
