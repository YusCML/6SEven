# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Patterns are deliberately NOT anchored with a leading slash, so they apply
# inside both client/ and server/.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# builds
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# Never commit real credentials.
.env
.env.local
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
**/generated/prisma

# prisma init drops AI-assistant skill files here; not app code
.agents
.windsurf
skills-lock.json
